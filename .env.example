# Copy this file to .env and fill in what you need. Everything is optional:
# with no keys and no Neo4j the app still runs fully (rule-based answers, in-memory graph).

# --- AI answers (GraphRAG) -------------------------------------------------
# Free key: https://aistudio.google.com/apikey
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Or any OpenAI-compatible server (OpenAI, Groq, OpenRouter, local Ollama):
# LLM_PROVIDER=openai
# OPENAI_API_KEY=ollama
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_MODEL=llama3.1

# --- Neo4j (optional) ----------------------------------------------------------
# docker run -d --name heatshield-neo4j -p 7474:7474 -p 7687:7687 -e NEO4J_AUTH=neo4j/heatshield123 neo4j:5
NEO4J_ENABLED=true
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=heatshield123

# --- Document search -----------------------------------------------------------
# Set to "none" to skip downloading the embedding model and use LSA only.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
